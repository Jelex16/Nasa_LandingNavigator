{
  "name": "lua-navigator",
  "version": "1.0.0",
  "private": true,
  "description": "Lua Navigator: lunar south-pole landing-site decision tool with real NASA LOLA terrain and JPL Horizons ephemerides (NASA Space Apps 2026).",
  "siDisclosure": {
    "assisted": true,
    "tools": "Gemini-family AI coding assistant",
    "scope": "Code drafting, review, tests, documentation and data-generation scripts; not the challenge idea or scientific interpretation.",
    "details": "docs/SI_USAGE.md"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "data:ephemerides": "node scripts/build_jpl_ephemerides.mjs",
    "data:fix-azimuth": "node scripts/fix_horizon_azimuth.mjs",
    "data:regional-horizons": "python scripts/build_regional_horizons.py --north-mode true",
    "data:clps-horizons": "python scripts/build_clps_horizons.py",
    "data:terrain-validation": "python scripts/validate_horizons.py",
    "data:sweep": "node scripts/build_monthly_sweep.mjs",
    "data:flat-horizons": "node scripts/build_flat_horizons.mjs",
    "data:si-metadata": "node scripts/add_si_metadata.mjs",
    "data:manifest": "node scripts/update_manifest.mjs"
  },
  "devDependencies": {
    "vite": "^8.3.6"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "three": "^0.187.0"
  }
}
