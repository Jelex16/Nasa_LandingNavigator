{
  "name": "lunar-landing-site-navigator",
  "version": "1.0.0",
  "private": true,
  "description": "Lunar south-pole landing-site decision tool with real NASA LOLA terrain and JPL Horizons ephemerides (NASA Space Apps 2026).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data:fix-azimuth": "node scripts/fix_horizon_azimuth.mjs",
    "data:regional-horizons": "python scripts/build_regional_horizons.py --north-mode true",
    "data:sweep": "node scripts/build_monthly_sweep.mjs"
  },
  "devDependencies": {
    "vite": "^8.3.6"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "three": "^0.187.0"
  }
}
